{
  "services": {
    "web": {
      "root": "apps/web",
      "bindings": [
        {
          "type": "service",
          "service": "council-engine",
          "format": "url",
          "env": "COUNCIL_ENGINE_INTERNAL_URL"
        }
      ]
    },
    "council-engine": {
      "root": "apps/council-engine",
      "entrypoint": "app.api.main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
