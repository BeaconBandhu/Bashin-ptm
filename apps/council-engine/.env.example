# Copy to .env for local dev. All settings are optional in Phase 0 — the
# engine falls back to in-memory stores when unset (see app/config.py) so
# `uvicorn app.api.main:app --reload` runs with zero infra.

ENV=dev

# Phase 1+: a Neon Postgres connection string (via the Vercel Marketplace).
# Unsetting reverts to the in-memory AuditStore/IdempotencyStore.
DATABASE_URL=

# Phase 1+: Upstash Redis, for the session buffer / idempotency store /
# rate-limit counters once those move off the in-process fallback.
REDIS_URL=

# Ticket store (tickets/queries/decisions/governance trail — what /v1/tickets
# and apps/web's /flow dashboard read). Unsetting reverts to the in-memory
# TicketStore. Local MongoDB: mongodb://localhost:27017/ — Atlas free tier:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=ai_teammate

# Service-to-service auth: Next.js signs requests over the private Vercel
# Services binding with this shared secret. Generate a real one per
# environment before deploying — never reuse the dev default.
INTERNAL_JWT_SECRET=dev-only-insecure-secret-change-me

# Phase 1+: Vercel AI Gateway key for single_model/council node execution.
AI_GATEWAY_API_KEY=

# Direct provider keys for the customer-support domain's Council tier (the
# only tier that spends money — RAG retrieval is TF-IDF, $0). Never commit
# real values here; this file is the template, .env (git-ignored) holds them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hard spend caps in USD, checked against real cumulative token-usage cost
# before every paid call by the ai_spend_limit guardrail — exceeding either
# auto-escalates to a human instead of calling out. Set below your actual
# account balance as a safety margin.
MAX_OPENAI_SPEND_USD=4.00
MAX_ANTHROPIC_SPEND_USD=6.00

# Groq (GroqCloud) — Council Triage role, self-serve catalog is GPT-OSS
# models (Llama now requires an enterprise conversation). Free tier is
# generous (~500K tokens/day) so Triage should run near-$0.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MAX_GROQ_SPEND_USD=2.00

# LangSmith — optional LangGraph tracing/observability. Unset = tracing
# simply doesn't activate, no code changes needed either way.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-teammate-council-engine
